// Lingering would keep user@1500.service, and thereby the guest's tmpfs home, alive after logout.
// loginctl enable-linger uses set-self-linger for the own account and set-user-linger for others.
polkit.addRule(function(action, subject) {
    if ((action.id == "org.freedesktop.login1.set-self-linger" ||
         action.id == "org.freedesktop.login1.set-user-linger") && subject.user == "guest") {
        return polkit.Result.NO;
    }
});
